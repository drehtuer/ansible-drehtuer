{{ ansible_managed | comment }}
#
# Outbound signing. There is deliberately no per-domain block here:
# the generic `path` below resolves $domain and $selector for every
# domain this host serves, so one line covers them all and cannot
# drift out of step with the keys the generator produced.
#
# The previous version had a block keyed on the host FQDN pointing at
# <fqdn>.mail.key - a file the generator never creates, since keys are
# per *domain*, not per host.
enabled = true;

# Sign mail this host originates and mail submitted by an
# authenticated user. Note the spelling: an earlier draft had
# `sign_authnenticated`, which RSpamd silently ignores, leaving
# submitted mail unsigned.
sign_local = true;
sign_authenticated = true;

# Logins here are bare names (`drehtuer`), and RSpamd's default of false
# skips signing any message whose login has no @domain to compare, with
# no error. Turning it on loses little: allow_hdrfrom_mismatch stays
# false, so the From domain must match the envelope's, and a domain with
# no key is not signed. What this check would add is already missing -
# see doc/TODO.adoc on sender login maps.
allow_username_mismatch = true;

selector = "{{ spam.dkim.selector }}";
path = "/var/lib/rspamd/dkim/$domain.$selector.key";

# Do not sign as a domain we hold no key for, rather than failing the
# message.
allow_missing_key = false;
