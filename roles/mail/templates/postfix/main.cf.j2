compatibility_level = 3.6

myhostname = mail.{{ domain }}
mydomain = {{ domain }}
myorigin = $mydomain
inet_interfaces = all
inet_protocols = all

mynetworks = 127.0.0.0/8 [::1]/128

# VRFY answers whether an address exists, and that is the whole
# problem: Postfix returns `252` for a real recipient and
# `550 ... User unknown in virtual mailbox table` for an invented one,
# so anyone can walk a word list and learn the valid addresses without
# sending a thing. Measured on this host before it was turned off -
# `VRFY root` answered 252 and `VRFY nosuchuser8842xyz` answered 550.
#
# Worth setting against what was in the log at the time: the busiest
# SMTP-AUTH target by a wide margin was the one genuinely valid
# account, with 4425 attempts, while everything else in the top ten
# was generic guessing - `info`, `admin`, `office`, `sales`. That is
# what an attacker does when it knows which name is real. VRFY is not
# proven to be where it learned that, but it is one open door and it
# is used by nothing: RFC 5321 permits refusing it, and no mail client
# needs it.
disable_vrfy_command = yes

# SMTP defaults
smtpd_relay_restrictions = 
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_recipient_restrictions = 
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_authenticated_sender_login_mismatch,
    reject_unknown_sender_domain

# SSL
smtpd_tls_cert_file = {{ mail.ssl.cert }}
smtpd_tls_key_file = {{ mail.ssl.key }}
smtpd_use_tls = yes
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes

smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high

# Outbound TLS. Opportunistic: try STARTTLS with every peer and fall
# back to cleartext for the ones that do not offer it, which is the
# only workable policy for a public MX - `encrypt` would bounce mail
# to any server still running without TLS.
#
# This setting is what actually turns outbound TLS on. Without it
# Postfix falls back to smtp_use_tls, which defaults to no, and the
# protocol/cipher lines below have no effect at all - so mail this
# host sent went out in the clear even to peers offering STARTTLS.
smtp_tls_security_level = may
smtp_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_ciphers = high
smtp_tls_mandatory_ciphers = high

# One line per delivery recording whether it was encrypted and with
# what, so "was that message protected in transit" is answerable
# afterwards rather than a guess.
smtp_tls_loglevel = 1
smtpd_tls_loglevel = 1

smtpd_tls_received_header = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth

smtpd_banner = $mydomain ESMTP

# LMTP -> dovecot
virtual_transport = lmtp:unix:private/dovecot-lmtp
# local_transport = error:local delivery disabled

mydestination = $myhostname, localhost.$mydomain, localhost
relay_domains =

# Every domain whose mail is delivered into a mailbox here: the primary
# domain, each alias domain, and this host's own name.
#
# The alias domains are what make a second domain real rather than
# decorative. Previously only $mydomain was listed, and an alias domain
# was not in ANY address class: virtual_alias_domains defaults to
# $virtual_alias_maps, but that looks the bare domain up as a key and
# the entries in /etc/valiases are keyed on full addresses, so it never
# matched. The addresses with an alias entry still worked, because
# alias rewriting runs for every recipient whatever class it is in -
# which is exactly what made the gap easy to miss.
#
# An ordinary account at the alias domain therefore fell through to the
# default class and Postfix tried to deliver it *off-host*:
# "relay=none ... status=bounced (Host or domain name not found)" - or
# was refused as an unauthorised relay when the client was not trusted.
# Not a refusal to notice, and not something correct DNS would fix.
# Verified on the lab by restoring the old settings and watching the
# same message bounce.
#
# One inbox per account, not one per domain. Delivery goes over LMTP to
# Dovecot, whose `auth_username_format = %n` strips the domain before
# the userdb lookup, so <user>@<any domain in this list> resolves to the
# same system account and lands in the same Maildir. That is also why an
# account authenticates the same whichever domain the client is
# configured with. See roles/imap.
{# $myhostname is deliberately NOT in this list. It is in
   mydestination above, and Postfix advises against a name appearing in
   both without saying which wins - so it was established by experiment
   on 2026-08-16 rather than assumed: mail to root@mail.<domain> is
   handled by `relay=local`, which applies the alias and only then hands
   the rewritten address to Dovecot over LMTP. The local transport owns
   the name, so listing it here changed nothing and only kept the
   warning in the log. See doc/STATUS.adoc. #}
{% set mailbox_domains = [domain] + domain_aliases %}
virtual_mailbox_domains = {{ mailbox_domains | join(' ') }}

# Set explicitly, and deliberately empty. It defaults to
# $virtual_alias_maps, which would put every domain on the left of
# /etc/valiases into virtual_alias_domains *as well as* the list above -
# and Postfix warns against a domain being in both, because a domain
# treated as alias-only has no mailboxes and rejects anything the alias
# map does not rewrite. Leaving it empty makes the line above the single
# answer to "which domains does this host accept mail for", and the
# alias map purely a rewriting table.
virtual_alias_domains =

# Which addresses inside those domains actually exist. Empty until
# 2026-08-17, and that was not a small gap: with no map to check,
# Postfix answered `250 2.1.5 Ok` to every recipient in either domain,
# handed it to Dovecot over LMTP, was refused there, and generated a
# bounce afterwards. On spam the envelope sender is forged, so those
# bounces went to third parties - backscatter this host emitted rather
# than received.
#
# It is also what produced the two DMARC `reject` records that arrived
# on 2026-08-17. A Postfix-generated bounce carries a null return path,
# so the receiver falls back to the HELO name for SPF and gets
# mail.<domain>, which is neither published nor aligned under aspf=s;
# and until internal_mail_filter_classes below it never reached the
# milter, so it carried no DKIM signature either.
#
# Note which way the risk runs. This map does not improve delivery, it
# *restricts* it: together with smtpd_reject_unlisted_recipient below it
# turns "accept everything" into "accept exactly this list", so an
# address missing from it is refused at the door rather than
# mis-delivered. roles/mail asserts that postmaster survives before
# rendering it.
virtual_mailbox_maps = hash:/etc/vmailbox

# The default, spelled out because virtual_mailbox_maps only does
# anything through it: this is what makes Postfix consult the map
# during the SMTP transaction and answer `550 5.1.1` to an address that
# is not in it. Setting it to `no` restores the old behaviour of
# accepting everything and bouncing later.
smtpd_reject_unlisted_recipient = yes

# Mail aliases
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
virtual_alias_maps = hash:/etc/valiases

# RSpamd
smtpd_milters = inet:127.0.0.1:{{ spam.milter_port }}
non_smtpd_milters = inet:127.0.0.1:{{ spam.milter_port }}
milter_default_action = accept
milter_protocol = 6

# Put Postfix's own bounces through the milter as well. The default is
# empty, i.e. mail the bounce daemon generates bypasses RSpamd entirely
# and goes out unsigned - which under this domain's `p=reject; adkim=s`
# means every DSN is discarded by any receiver that enforces DMARC, so
# a genuine delivery failure never reaches the sender who caused it.
# Signed, the From: is MAILER-DAEMON@$myorigin - the primary domain,
# which aligns strictly - so the bounce passes on DKIM alone, and
# unlike SPF that survives being forwarded.
#
# Postfix warns that inspecting its own notifications is unsafe with a
# filter that can reject, because the rejected bounce is then lost.
# That does not apply here: `reject = null` in RSpamd's actions.conf
# means it never rejects, and milter_default_action above fails open.
#
# Ordering note for anyone reading this as a fix for backscatter: it is
# not one, and on its own it makes things worse. Signing bounces makes
# them *deliverable*, so it belongs after virtual_mailbox_maps above
# stops them being generated for forged senders in the first place.
#
# `notify` is deliberately not listed. Those are postmaster
# notifications, delivered locally, and they never face a
# DMARC-enforcing receiver.
internal_mail_filter_classes = bounce
