{{ ansible_managed | comment }}
#
# Read by compose.yml's `env_file`. It holds the two values that must
# not be in a world-readable file, and nothing else - keeping the
# compose file itself reviewable and diffable rather than no_log.
#
# Compose parses this as KEY=VALUE with no shell quoting, so each
# value is taken literally to the end of the line. A `#` or a `!`
# inside the password is safe; a trailing space is not, because it
# would be part of it.
SERVER_PASS={{ valheim.server.password }}

# SteamID64s granted admin in game, space separated. Here rather than
# in compose.yml because a SteamID64 identifies a real account, and
# the inventory keeps them vaulted for that reason.
#
# These arrive as Ansible's vault type rather than as plain strings.
# `join` coerces them to the decrypted value by itself - checked,
# rather than assumed, because the same assumption is false a few
# operators away: `x in y` raises a type error on a vaulted operand
# and needs an explicit `| string`.
ADMINLIST_IDS={{ valheim.server.admin_ids | join(' ') }}
