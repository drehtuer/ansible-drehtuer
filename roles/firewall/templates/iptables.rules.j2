{#
  Shared by rules.v4 and rules.v6. `ip_version` (4 or 6) is set by the
  task that renders it - keeping one template means a fix cannot land
  for one address family and be forgotten for the other.
#}
{# `| int` so a templated "6" compares equal to 6 rather than silently
   falling through to the IPv4 branch. #}
{% set v6 = (ip_version | int) == 6 %}
{{ ansible_managed | comment }}
*filter

# Drop by default
:INPUT DROP [0:0]
:FORWARD DROP [0:0]

# Outgoing traffic is allowed
:OUTPUT ACCEPT [0:0]

# Protocol chains
:TCP - [0:0]
:UDP - [0:0]
{% if firewall.docker.enabled %}

# Docker consults DOCKER-USER before its own rules, and it is the only
# chain here Docker will not overwrite. Declaring it keeps
# iptables-restore from deleting it while Docker is running.
:DOCKER-USER - [0:0]
{% endif %}

# Allow established and related connections
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# Allow loopback interface
-A INPUT -i lo -j ACCEPT

# Invalid states, for every protocol rather than just tcp
-A INPUT -m conntrack --ctstate INVALID -j DROP

{% if v6 %}
# ICMP
-A INPUT -p ipv6-icmp --icmpv6-type packet-too-big -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type time-exceeded -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type parameter-problem -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type echo-request -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type router-solicitation -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type router-advertisement -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type neighbor-solicitation -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type neighbor-advertisement -j ACCEPT
-A INPUT -p ipv6-icmp --icmpv6-type redirect -j ACCEPT
{% else %}
# ICMP ping
-A INPUT -p icmp -m icmp --icmp-type echo-request -m conntrack --ctstate NEW -j ACCEPT
{% endif %}

# Forward to chains
-A INPUT -p tcp --tcp-flags FIN,SYN,RST,ACK SYN -m conntrack --ctstate NEW -j TCP
-A INPUT -p udp -m conntrack --ctstate NEW -j UDP

# Reject all other traffic
-A INPUT -p tcp -j REJECT --reject-with tcp-reset
-A INPUT -p udp -j REJECT --reject-with {{ 'icmp6-port-unreachable' if v6 else 'icmp-port-unreachable' }}
-A INPUT -j REJECT --reject-with {{ 'icmp6-adm-prohibited' if v6 else 'icmp-proto-unreachable' }}

# TCP rules
# Rate limiting, e.g. for SSH
# https://www.ssh-audit.com/hardening_guides.html#ubuntu_24_04_lts
#
# Driven by `rate_limit` on the rule itself so that moving a service
# to another port cannot leave the limiter pointing at the old one.
{% for tcp in firewall.rules.tcp if tcp.rate_limit | default(false) %}
-A TCP -p tcp --dport {{ tcp.port }} -m conntrack --ctstate NEW -m recent --name ratelimit{{ tcp.port }} --set
-A TCP -p tcp --dport {{ tcp.port }} -m conntrack --ctstate NEW -m recent --name ratelimit{{ tcp.port }} --update --seconds {{ firewall.rate_limit.seconds }} --hitcount {{ firewall.rate_limit.hitcount }} -j DROP
{% endfor %}

{% for tcp in firewall.rules.tcp %}
-A TCP -p tcp --dport {{ tcp.port }} -m conntrack --ctstate NEW -m comment --comment "{{ tcp.comment }}" -j ACCEPT
{% endfor %}

# UDP rules
{% for udp in firewall.rules.udp | default([]) %}
-A UDP -p udp --dport {{ udp.port }} -m conntrack --ctstate NEW -m comment --comment "{{ udp.comment }}" -j ACCEPT
{% endfor %}
{% if firewall.wireguard.enabled %}

# VPN traffic
#
# The FORWARD policy is DROP, so a packet that is routed rather than
# delivered locally needs an explicit accept. Two directions matter:
#
#   * out of the tunnel - to the internet, and to another peer. One
#     rule covers both, because "came in on wg0" is the whole
#     condition; where it is going is decided by AllowedIPs in the
#     tunnel configuration, which is the authorisation check that
#     matters and has already happened by this point.
#   * back in, which is conntrack's job alone. Nothing from the
#     internet may open a connection to a peer.
-A FORWARD -i {{ firewall.wireguard.interface }} -m comment --comment "VPN peers out, and to each other" -j ACCEPT
-A FORWARD -o {{ firewall.wireguard.interface }} -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment "VPN return traffic" -j ACCEPT
{% endif %}
{% if firewall.docker.enabled %}

# Container traffic
#
# Published container ports are DNATed and traverse FORWARD, never
# INPUT, so the allow-list above does not apply to them. Without the
# drop below, `docker run -p 5432:5432` is reachable from the
# internet no matter what INPUT says.
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
{% for tcp in firewall.docker.published.tcp | default([]) %}
-A DOCKER-USER -i {{ firewall.docker.wan_interface }} -p tcp --dport {{ tcp.port }} -m comment --comment "{{ tcp.comment }}" -j RETURN
{% endfor %}
{% for udp in firewall.docker.published.udp | default([]) %}
-A DOCKER-USER -i {{ firewall.docker.wan_interface }} -p udp --dport {{ udp.port }} -m comment --comment "{{ udp.comment }}" -j RETURN
{% endfor %}
-A DOCKER-USER -i {{ firewall.docker.wan_interface }} -j DROP
{% endif %}

COMMIT
{% if firewall.wireguard.enabled %}

# The nat table exists for the VPN alone.
#
# Worth knowing: restoring this file now flushes nat as well as
# filter, which takes Docker's DOCKER and DOCKER-POSTROUTING chains
# with it. That is why the role notifies a Docker restart - the same
# reason it already did for the filter table, now with a second table
# behind it.
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

# Networks that permit nothing but 443 outbound. The tunnel listens
# once, on its own port, and this puts a second door on it rather than
# a second interface.
#
# It defeats a port filter and not a protocol one: anything inspecting
# the payload still sees WireGuard, which is not trying to look like
# TLS. Reserving udp/443 also means HTTP/3 cannot have it later.
-A PREROUTING -i {{ firewall.wireguard.wan_interface }} -p udp --dport {{ firewall.wireguard.redirect_port }} -m comment --comment "VPN fallback port" -j REDIRECT --to-ports {{ firewall.wireguard.listen_port }}

# Peers leave under this host's own address.
#
# For IPv6 this is NAT66, which is a deliberate choice rather than an
# oversight: the host's global /64 is on-link at Hetzner, so an
# address from it handed to a peer is not reachable unless this host
# answers NDP for it. Peers use a ULA and are masqueraded instead.
# The cost is that nothing can open a connection *to* a peer from
# outside, which for personal devices is closer to a feature.
-A POSTROUTING -s {{ firewall.wireguard.network['ip6' if v6 else 'ip4'] }} -o {{ firewall.wireguard.wan_interface }} -m comment --comment "VPN egress" -j MASQUERADE
COMMIT
{% endif %}
