{{ ansible_managed | comment }}
#
# Serves the generated GoAccess report, modelled on the `spam` and
# `fail2ban_ui` vhosts. A static file and nothing else: there is no
# application behind this name, so there is nothing to proxy and
# nothing to authenticate against underneath. The basic-auth block is
# the whole access control, and what it protects is a page listing
# which addresses asked for what and when.
#
# conf-server/security.conf is deliberately NOT included here, for the
# same reason roles/monitoring cannot include it: nginx *accumulates*
# add_header at one level rather than replacing, and a browser given
# two Content-Security-Policy headers enforces both, which would undo
# the policy widened below. Its headers are reproduced here instead,
# and so is its dot-file deny.
server {
  listen {{ http.port_https }} ssl http2;
  listen [::]:{{ http.port_https }} ssl http2;

  include conf-server/ssl.conf;
  include conf-server/general.conf;

  # One name per served domain, as the cloud, spam and f2b vhosts do.
  # The certificate covers each of them through
  # http.letsencrypt.subdomains, which must therefore list
  # analytics.subdomain.
  server_name {{ http.domains | map('regex_replace', '^', analytics.subdomain ~ '.') | join(' ') }};

  root {{ analytics.report_dir }};
  index {{ analytics.report_file }};

  # This vhost's own requests are not recorded, so that the report
  # does not measure the act of reading it - a page of this size
  # reloaded a few times a day would otherwise sit near the top of its
  # own "most requested" panel. Two things worth knowing before
  # removing this line or copying it elsewhere: fail2ban's
  # `nginx-http-auth` jail reads error.log, not this file, so failed
  # logins here are still banned; and its `nginx-404` jail does read
  # this file, so 404s on this vhost alone are not counted towards a
  # ban.
  access_log off;

  # Declared once at server level so every location inherits them.
  # No location below may declare an add_header of its own: nginx
  # drops every inherited one the moment a block sets any, and that is
  # invisible to `nginx -t`.
  #
  # The policy is security.conf's, widened by 'unsafe-eval' alone.
  # GoAccess bundles Hogan and compiles every panel template with
  # `new Function()` - `i.code = new Function("c","p","i", ...)` - and
  # 'unsafe-inline' does not permit that; only 'unsafe-eval' does.
  # Without it the report is fetched, its JavaScript runs, Hogan
  # throws on the first panel, and the two lines that reveal the page
  # never run:
  #
  #   $('.container').classList.remove('hide');
  #   $('.spinner').classList.add('hide');
  #
  # so the page is a spinner that never stops. It answers 200 the
  # whole time. A status code does not test this - a browser does,
  # which is exactly the lesson roles/monitoring recorded for Grafana
  # and this vhost then repeated.
  #
  # Nothing else is widened. The report needs no blob: and no worker:
  # checked against the generated file rather than copied from the
  # monitoring vhost, which needs both for Grafana.
  add_header X-Content-Type-Options    "nosniff" always;
  add_header Referrer-Policy           "no-referrer-when-downgrade" always;
  add_header Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
  add_header Permissions-Policy        "interest-cohort=()" always;
  # Repeated verbatim from conf-server/security.conf. Every HSTS
  # header in this repo carries this exact value, without the
  # `preload` token - see doc/STATUS.adoc.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # From conf-server/security.conf, which this vhost cannot include.
  # Not idle here either: the report is written as a dotfile and
  # renamed into place, so this also hides the temporary during the
  # second it exists.
  location ~ /\.(?!well-known) {
    deny all;
  }

  location / {
    auth_basic "Restricted Access";
    auth_basic_user_file /etc/nginx/sites-enabled/analytics.htpasswd;

    try_files $uri $uri/ =404;
  }
}
