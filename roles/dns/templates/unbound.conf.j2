{{ ansible_managed | comment }}
server:
  interface: 127.0.0.1
  interface: ::1
{% if dns.vpn.enabled %}
  # The tunnel's own addresses, so peers resolve through this
  # validating recursor instead of whatever network they are sitting
  # on. With a full tunnel that is the difference between the local
  # network seeing every name looked up and seeing none of them.
  interface: {{ dns.vpn.server.ip4 }}
  interface: {{ dns.vpn.server.ip6 }}
  # Bind an address that does not exist yet. unbound starts before
  # wg-quick brings the interface up, and without this it fails at
  # startup with "can't bind socket: Cannot assign requested address"
  # - on every boot, not just the first.
  ip-freebind: yes
{% endif %}
  access-control: 127.0.0.0/8 allow
  access-control: ::1 allow
{% if dns.vpn.enabled %}
  # Only the tunnel ranges. The addresses above are reachable through
  # wg0 alone, and the firewall does not permit 53 in from anywhere
  # else, so this is the third of three independent reasons this is
  # not an open resolver.
  access-control: {{ dns.vpn.network.ip4 }} allow
  access-control: {{ dns.vpn.network.ip6 }} allow
{% endif %}
  access-control: 0.0.0.0/0 refuse
  access-control: ::0/0 refuse

  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes

  auto-trust-anchor-file: "/var/lib/unbound/root.key"

  qname-minimisation: yes
  hide-identity: yes
  hide-version: yes
  hide-http-user-agent: yes

  minimal-responses: yes

  # Cache tuning. This resolver serves one host that queries the same
  # names repeatedly, so the defaults (4m each) are small.
  msg-cache-size: 32m
  rrset-cache-size: 64m
  # Renew a popular entry shortly before it expires, rather than
  # making the next client wait for the recursion. prefetch-key does
  # the same for the DNSSEC keys needed to validate it.
  prefetch: yes
  prefetch-key: yes

  val-clean-additional: yes
  harden-algo-downgrade: yes
  harden-dnssec-stripped: yes
  harden-large-queries: yes
  harden-short-bufsize: yes

  # Prevent private IP leakage
  private-address: 10.0.0.0/8
  private-address: 172.16.0.0/12
  private-address: 192.168.0.0/16
  private-address: 169.254.0.0/16
  private-address: fd00::/8
{% if dns.vpn.enabled %}
  # The tunnel ranges are inside the two entries above already
  # (10.0.0.0/8 and fd00::/8). Left as they are on purpose: nothing
  # here resolves to a tunnel address, so there is no answer to
  # protect, and narrowing the guard to make room for one would weaken
  # the rebinding protection for every other name.
{% endif %}
  private-address: fe80::/10
  private-address: ::ffff:0:0/96

# Runtime statistics and cache inspection via `unbound-control stats`.
#
# Deliberately a unix socket, not the default TCP port 8953: a socket
# opens no network port at all, so there is nothing for an external
# address to reach even if the access-control rules above were ever
# loosened. Access is filesystem permissions only - root and the
# unbound user - which also removes the need for the control
# certificates `unbound-control-setup` would otherwise generate.
remote-control:
  control-enable: yes
  control-interface: /run/unbound.ctl
  control-use-cert: no
