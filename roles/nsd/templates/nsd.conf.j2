{{ ansible_managed | comment }}
#
# Authoritative DNS, running alongside unbound rather than instead of
# it: unbound stays on 127.0.0.1 answering recursive queries for this
# host, NSD binds the public addresses and answers authoritatively for
# the zones below. They cannot collide because each names its
# addresses explicitly.
#
# THIS IS NOT AN OPEN RESOLVER, and cannot become one by
# misconfiguration. NSD is authoritative-only software: it contains no
# recursion code whatsoever. A query for a name outside the zones
# below is answered REFUSED, never resolved on the client's behalf.
# That is the reason to use NSD here rather than BIND, which *can*
# recurse and merely has to be told not to.
#
# The recursive resolver on this host remains bound to loopback and
# refuses every other source (see roles/dns), so the public addresses
# below reach NSD only.
#
# unbound could not do this job in any case: its `auth-zone` only ever
# *downloads* a zone ("where to download a copy of the zone from, with
# AXFR and IXFR"). It has no way to answer a transfer request, so a
# secondary asking it for AXFR gets nothing.

server:
  # Public addresses only - loopback belongs to unbound. Listed
  # explicitly rather than derived from the host's facts: binding an
  # address the host does not actually have is a hard startup failure,
  # and not every host has both families.
  #
  # Never leave this empty. With no ip-address at all NSD binds every
  # interface, including loopback, where it would collide with the
  # resolver.
{% for addr in nsd.listen %}
  ip-address: {{ addr }}
{% endfor %}
  # Each family is enabled only when an address of that family is
  # actually listed above, and hardcoding both was a real fault rather
  # than an untidiness. `do-ip6: yes` with no IPv6 address in the list
  # does not disable IPv6 - it makes NSD bind the IPv6 *wildcard*,
  # which is the one thing the comment above says must never happen.
  # On a host that lists only IPv4 that means `::@53`, which collides
  # with the resolver's `::1` and leaves nsd refusing to start:
  # "can't bind udp socket ::@53: Address already in use".
  #
  # Invisible on `carcosa`, which lists both families, and found the
  # first time `playbooks/site.yml` provisioned nsd on a lab guest -
  # which lists only IPv4 because it has no real IPv6 address.
  do-ip4: {{ 'yes' if nsd.listen | reject('search', ':') | list else 'no' }}
  do-ip6: {{ 'yes' if nsd.listen | select('search', ':') | list else 'no' }}

  hide-version: yes
  identity: ""

  zonesdir: "/etc/nsd/zones"
  username: nsd

  # Response rate limiting. An authoritative server cannot be used as
  # an open resolver, but it can still be used as a reflector: an
  # attacker spoofs a victim's address and this host sends the reply
  # there. RRL caps how often the same answer goes to the same
  # network, which is the standard mitigation.
  rrl-size: {{ nsd.rrl.size }}
  rrl-ratelimit: {{ nsd.rrl.ratelimit }}
  rrl-whitelist-ratelimit: {{ nsd.rrl.whitelist_ratelimit }}

remote-control:
  # Unix socket, not the default TCP port 8952: nsd-control is local
  # administration and has no business being reachable over a network.
  control-enable: yes
  control-interface: /run/nsd/nsd.sock

{% if nsd.zones | selectattr('tsig.secret') | list %}
# The shared secrets authenticating zone transfers - one key per zone -
# in a file of their own so that they stay out of a --diff of this one.
# Included before the zones below, which reference their key by name.
include: "/etc/nsd/nsd.conf.d/tsig.conf"

{% endif %}
{% for zone in nsd.zones %}
{% set xfr_key = zone.tsig.name if zone.tsig.secret else 'NOKEY' %}
zone:
  name: "{{ zone.name }}"
{% if nsd.dnssec.enabled %}
  # The signed copy, produced by nsd-sign-zone from the file beside it.
  # nsd serves whatever this names and does no signing of its own, so
  # pointing it here is the moment signing takes effect - which is why
  # the role signs before it writes this file, never after.
  zonefile: "{{ zone.name }}.zone.signed"
{% else %}
  zonefile: "{{ zone.name }}.zone"
{% endif %}

  # Hetzner's secondaries pull the zone from here and are told when it
  # changes. NOTIFY makes them fetch promptly rather than waiting out
  # the SOA refresh interval; provide-xfr is what permits the transfer
  # at all, and names exactly those addresses - an unrestricted
  # provide-xfr hands the entire zone to anyone who asks for it.
  #
  # The two lists differ on purpose: transfers are permitted over both
  # address families, notifications are sent over IPv4 only. See
  # nsd.notify in the role defaults for why.
  #
{% if zone.tsig.secret %}
  # Both also require this zone's own TSIG key from the file above, so
  # a transfer is refused unless the peer proves it holds the shared
  # secret, and the zone the secondary receives is signed in a way it
  # can verify. The source address restriction stays as well: a spoofed
  # address alone no longer suffices, and neither does a key stolen
  # from elsewhere - or a valid key belonging to a different zone.
  #
  # The NOTIFY is signed too. If a secondary were to reject a signed
  # NOTIFY it would simply fall back to polling on the SOA refresh
  # interval, so the failure mode is slower propagation rather than a
  # stale zone.
{% else %}
  # NOKEY: transfers are restricted by source address only, which a
  # spoofed packet can defeat and which gives the secondary no way to
  # tell whether what it received was altered on the way. Set this
  # zone's tsig.secret to require a shared secret instead.
{% endif %}
{% for peer in nsd.notify %}
  notify: {{ peer }} {{ xfr_key }}
{% endfor %}
{% for peer in nsd.secondaries %}
  provide-xfr: {{ peer }} {{ xfr_key }}
{% endfor %}
  # Everyone else is refused by default, and there is deliberately no
  # catch-all `provide-xfr: 0.0.0.0/0 BLOCKED` to say so explicitly.
  # That looks like harmless belt and braces and is not: per
  # nsd.conf(5), "BLOCKED supersedes other entries, other entries are
  # scanned for a match afterwards" - so a catch-all BLOCKED blocks the
  # secondaries listed above as well and no transfer ever succeeds.
  # Verified both ways in the lab: with it, even the correct key and a
  # permitted address are refused; without it, an unlisted address is
  # still refused.

{% endfor %}
