{{ ansible_managed | comment }}
# Replaces the file shipped by the prometheus package, which is a
# dpkg conffile. Safe to take over here in a way that replacing
# Redis's packaged config was not: the packaged version only scrapes
# Prometheus itself, so nothing set by the distribution is lost by
# owning the whole file. Ansible re-asserts it on every run, and
# `invoke check-drift` reports it if anything edits it by hand.
{% set p = monitoring.prometheus %}
{% set a = monitoring.alertmanager %}
{% set n = monitoring.node_exporter %}
global:
  scrape_interval: {{ p.scrape_interval }}
  evaluation_interval: {{ p.evaluation_interval }}
  # Attached to every series leaving this server. Pointless with one
  # host and free to add; the alternative is discovering later that
  # every metric from every host is labelled identically.
  external_labels:
    host: {{ hostname }}

alerting:
  alertmanagers:
    # No path_prefix: Alertmanager is not served through the vhost and
    # keeps its default root path. Prometheus is the one with a route
    # prefix, and only because it *is* served there.
    - static_configs:
        - targets:
            - {{ a.listen_address }}:{{ a.port }}

# A glob rather than a list, so adding a rule file is one file rather
# than two edits. Note that this makes a rule file left behind by an
# earlier version of this role keep being evaluated - the role writes
# the directory's whole contents for that reason.
rule_files:
  - {{ p.rules_dir }}/*.rules.yml

# Everything scraped here is on loopback. Prometheus and Alertmanager
# are scraped as well as node_exporter, because the rules in
# monitoring.rules.yml watch the monitoring pipeline itself - an
# alerting system that cannot report its own failure is the failure
# mode to design against.
scrape_configs:
  - job_name: node
    static_configs:
      - targets:
          - {{ n.listen_address }}:{{ n.port }}

  - job_name: prometheus
    # Prometheus serves under a route prefix, so /metrics moved with
    # everything else it serves. Alertmanager above has none.
    metrics_path: {{ p.path }}metrics
    static_configs:
      - targets:
          - {{ p.listen_address }}:{{ p.port }}

  - job_name: alertmanager
    static_configs:
      - targets:
          - {{ a.listen_address }}:{{ a.port }}
{% set e = monitoring.exporters %}
{% if e.nginx.enabled %}

  # Connections, requests and the reading/writing/waiting split, out
  # of nginx's stub_status page. `nginx_up` says whether the exporter
  # could read that page, which is a stronger statement than the unit
  # being active.
  - job_name: nginx
    static_configs:
      - targets:
          - {{ e.listen_address }}:{{ e.nginx.port }}
{% endif %}
{% if e.mysqld.enabled %}

  # `mysql_up` plus connection, query and InnoDB counters. The
  # exporter authenticates over the unix socket, so this scrape is the
  # only network hop involved and it is loopback.
  - job_name: mysql
    static_configs:
      - targets:
          - {{ e.listen_address }}:{{ e.mysqld.port }}
{% endif %}
{% if e.redis.enabled %}

  # `redis_up`, memory, keyspace and eviction counters. Worth having
  # for a reason this host has already met: Redis lost its `dir`
  # setting once and refused every write, which PING could not see and
  # which broke RSpamd's Bayes learning and Nextcloud's file locking
  # silently.
  - job_name: redis
    static_configs:
      - targets:
          - {{ e.listen_address }}:{{ e.redis.port }}
{% endif %}
{% if e.postfix.enabled %}

  # Queue sizes by queue, delivery delays, and SMTP status counts,
  # read from the mail log and the showq socket. The deferred queue is
  # the one worth watching: it grows quietly and is the first sign of
  # mail this host accepted and cannot deliver.
  - job_name: postfix
    static_configs:
      - targets:
          - {{ e.listen_address }}:{{ e.postfix.port }}
{% endif %}
{% if e.dovecot.enabled %}

  # Dovecot exports these itself - no exporter package - from the
  # `metric` blocks in roles/imap's dovecot.conf. Authentication
  # successes and failures are the interesting pair, since the ratio
  # is what tells a brute-force campaign from a busy morning.
  - job_name: dovecot
    static_configs:
      - targets:
          - {{ e.listen_address }}:{{ e.dovecot.port }}
{% endif %}
{% if e.rspamd.enabled %}

  # RSpamd's controller serves /metrics itself. It authenticates with
  # a `Password` header and rejects HTTP basic auth outright, which is
  # why this uses http_headers rather than basic_auth - and why the
  # scrape would answer 401 with the obvious configuration.
  - job_name: rspamd
    http_headers:
      Password:
        values:
          - {{ e.rspamd.password }}
    static_configs:
      - targets:
          - {{ e.listen_address }}:{{ e.rspamd.port }}
{% endif %}
{% if monitoring.blackbox.enabled %}
{% set b = monitoring.blackbox %}
{#
  The probed web names are the cross product of the configured
  subdomains and http.domains, exactly as roles/http builds
  server_name - so a domain added there is probed without touching
  this role. The empty subdomain is the apex, and the regex_replace is
  what turns the ".example.com" that joining produces back into
  "example.com".

  Computed here rather than in the role's vars/main.yml so that the
  static tests, which render templates from the test inventory alone,
  exercise the derivation itself rather than a hand-written copy of
  its result.
#}
{% set probe_public = b.web.public | product(http.domains)
     | map('join', '.') | map('regex_replace', '^\.', '') | list %}
{% set probe_guarded = b.web.guarded | product(http.domains)
     | map('join', '.') | map('regex_replace', '^\.', '') | list %}
{#
  Every blackbox job needs the same four relabel steps, so they are
  written once here and used by each job below. The dance is not
  decoration: the exporter is scraped at ITS address with the real
  target as a URL parameter, so `targets` has to be moved into
  `__param_target`, copied to `instance` so the series is labelled by
  what was probed rather than by the exporter, and `__address__` then
  replaced with the exporter itself. Miss the last step and Prometheus
  scrapes the probed host directly.
#}
{% macro probe_relabel() %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ b.listen_address }}:{{ b.port }}
{%- endmacro %}

  # Names that must answer 2xx.
  - job_name: probe_https
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
      - targets:
{% for name in probe_public %}
          - https://{{ name }}/
{% endfor %}
{{ probe_relabel() }}

  # Names that must answer 401, i.e. the basic-auth gate is still in
  # front of them. A 200 here is a finding.
  - job_name: probe_https_guarded
    metrics_path: /probe
    params:
      module: [https_401]
    static_configs:
      - targets:
{% for name in probe_guarded %}
          - https://{{ name }}/
{% endfor %}
{{ probe_relabel() }}

  # Postfix, reached the way a sending MX and a submitting client
  # reach it. The STARTTLS handshake is also what measures the
  # certificate Postfix serves, which is a different question from the
  # one nginx serves - see probes.rules.yml.
  - job_name: probe_smtp
    metrics_path: /probe
    params:
      module: [smtp_starttls]
    static_configs:
      - targets:
{% for port in b.mail.starttls_ports %}
          - {{ b.mail.host }}:{{ port }}
{% endfor %}
{{ probe_relabel() }}

  # Dovecot, likewise, and likewise for its own copy of the
  # certificate.
  - job_name: probe_imap
    metrics_path: /probe
    params:
      module: [imaps]
    static_configs:
      - targets:
{% for port in b.mail.imaps_ports %}
          - {{ b.mail.host }}:{{ port }}
{% endfor %}
{{ probe_relabel() }}
{% if b.dns.authoritative.enabled %}
{% for zone in b.dns.authoritative.zones %}

  # NSD answering authoritatively for {{ zone }}. One job per zone,
  # because the queried name is a module setting rather than something
  # the scrape can pass.
  - job_name: probe_dns_{{ zone | replace('.', '_') | replace('-', '_') }}
    metrics_path: /probe
    params:
      module: [dns_soa_{{ zone | replace('.', '_') | replace('-', '_') }}]
    static_configs:
      - targets:
          - {{ b.dns.authoritative.server }}
{{ probe_relabel() }}
{% endfor %}
{% for record in b.dns.authoritative.records %}

  # {{ record.name }} {{ record.type }} existing at all. Same server as the zone
  # jobs above and a different question: that the record is in the
  # zone being served, not merely that the zone is.
  - job_name: probe_dns_{{ record.name | replace('.', '_') | replace('-', '_') }}_{{ record.type | lower }}
    metrics_path: /probe
    params:
      module: [dns_record_{{ record.name | replace('.', '_') | replace('-', '_') }}_{{ record.type | lower }}]
    static_configs:
      - targets:
          - {{ b.dns.authoritative.server }}
{{ probe_relabel() }}
      # One more step than the other probes, because `instance` is the
      # probed *target* - and for a DNS probe that is the server, not
      # the name asked for. Every record probe would otherwise be
      # labelled with the same address, the name legible only inside
      # the mangled job name; on a dashboard row beside
      # `https://cloud.example.com/` that reads as though the record
      # were not being watched at all.
      #
      # The zone probes above are left alone deliberately: their job
      # name already carries the zone, and rewriting `instance` there
      # would break the continuity of series that have history.
      - target_label: instance
        replacement: {{ record.name }}/{{ record.type }} @{{ b.dns.authoritative.server }}
{% endfor %}
{% endif %}
{% if b.dns.recursive.enabled %}

  # unbound, asked for a name it has to recurse for. RSpamd's resolver
  # points here, so this failing means SPF, DKIM, DMARC and every RBL
  # check quietly stop working.
  - job_name: probe_dns_recursive
    metrics_path: /probe
    params:
      module: [dns_recursive]
    static_configs:
      - targets:
          - {{ b.dns.recursive.server }}
{{ probe_relabel() }}
{% endif %}
{% endif %}
