!include_try /usr/share/dovecot/protocols.d/*.protocol
protocols = imap lmtp{{ ' sieve' if imap.managesieve.enabled else '' }}
listen = *, ::

# Auth
disable_plaintext_auth = yes
auth_mechanisms = plain login

# This one line is what makes the whole multi-domain setup share a
# single set of mailboxes, so it is load-bearing rather than cosmetic.
# %n is the local part alone: the domain is dropped before either
# lookup below, so a bare <user> and <user>@<domain> for every domain
# this host serves - {{ ([domain] + domain_aliases) | join(', ') }} -
# are one and the same account.
#
# It applies to every auth request, not only to logins - Dovecot looks
# the recipient up the same way when Postfix hands a message over on
# LMTP. That is what puts mail addressed to any of this host's domains
# into one inbox instead of one inbox per domain, and it is why a client
# configured with either domain authenticates identically.
#
# Accounts are system users (pam/passwd below), which have no domain to
# begin with, so there is nothing here that could distinguish them per
# domain even if that were wanted. Note what that implies and is worth
# knowing rather than discovering: the domain part is *discarded*, not
# checked, so an IMAP client offering <user>@anything.example logs in
# just as well as one offering a domain this host actually serves. It
# is one account either way, so nothing is reachable that would not
# otherwise be - but Dovecot is not the component that decides which
# domains this host answers for. Postfix is, for mail, through
# virtual_mailbox_domains in roles/mail.
auth_username_format = %n
passdb {
  driver = pam
}
userdb {
  driver = passwd
}

# Logging
log_path = {{ imap.conf.logfile }}

# Mailbox
mail_location = maildir:{{ imap.conf.maildir }}
namespace inbox {
  type = private
  inbox = yes
  hidden = no
  list = yes
  subscriptions = yes
}
mail_privileged_group = mail
mail_access_groups = mail

# Master
service imap-login {
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

{% if imap.managesieve.enabled %}
# ManageSieve, which is what lets a user edit their own sieve script
# from a client rather than by an inventory change here. It is the
# protocol behind Nextcloud Mail's filter editor.
#
# No `ssl = yes` on the listener: 4190 is STARTTLS by convention, not
# implicit TLS, and `disable_plaintext_auth = yes` above already
# refuses credentials until the connection is secured.
#
# Note what this does *not* decide. The listener inherits
# `listen = *, ::` exactly as imaps does, so reachability is
# roles/firewall's: it opens 993 and does not open this port, which
# leaves the world out while `-A INPUT -i lo -j ACCEPT` still lets
# this host connect to its own public address - the path Nextcloud
# takes, running on this same machine. A desktop client from outside
# needs a rule for {{ imap.managesieve.port }} added there.
service managesieve-login {
  inet_listener sieve {
    port = {{ imap.managesieve.port }}
  }
}

{% endif %}
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

protocol lmtp {
  postmaster_address = postmaster@{{ domain }}
  mail_plugins = $mail_plugins sieve
}

# imap_sieve is what makes the imapsieve_mailbox* rules below do
# anything at all. Without it dovecot loads the settings, reports no
# error, and simply never fires the training scripts - moving a
# message into TrainSpam succeeds and teaches RSpamd nothing.
protocol imap {
  mail_plugins = $mail_plugins imap_sieve
}

{% if imap.metrics.enabled %}
# Dovecot exports its own statistics in Prometheus format - there is no
# Dovecot exporter to install, and nothing here parses a log. The
# listener is loopback only, like every other part of the monitoring
# stack, and carries no authentication because nothing off-host can
# reach it.
#
# The `metric` blocks below are what makes the export worth scraping:
# without them the endpoint answers with process-level counters only.
# Each one names an event Dovecot already emits, so this is a
# subscription rather than new bookkeeping.
service stats {
  inet_listener http {
    address = {{ imap.metrics.listen_address }}
    port = {{ imap.metrics.port }}
  }
}

# Logins that succeeded and logins that failed, by protocol. The pair
# is what makes a brute-force campaign visible as a ratio rather than
# as a count that could equally be a busy morning.
metric auth_success {
  filter = event=auth_request_finished AND success=yes
}

metric auth_failure {
  filter = event=auth_request_finished AND success=no
}

# Deliveries handed over by Postfix over LMTP, and how long they took.
metric mail_delivery {
  filter = event=mail_delivery_finished
}

# IMAP commands, so a client stuck in a loop is visible as something
# other than load.
metric imap_command {
  filter = event=imap_command_finished
  group_by = cmd_name
}

{% endif %}
service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}

# SSL
ssl = yes
ssl_cert = <{{ imap.conf.ssl.cert }}
ssl_key = <{{ imap.conf.ssl.key }}
ssl_ca = <{{ imap.conf.ssl.ca }}
# No ssl_dh: Dovecot 2.3+ does not need explicit DH parameters for
# TLS 1.2+ ECDHE, and pointing it at /etc/nginx/dhparam.pem made
# the imap role silently depend on the http role having run first.
ssl_min_protocol = TLSv1.2
ssl_cipher_list = HIGH:!aNULL:!MD5:!3DES:!RC4:!DSS:!SHA1:!SHA256:!SHA384:!CAMELLIA128:!CAMELLIA256
ssl_prefer_server_ciphers = yes

# Mailbox definitions
namespace inbox {
  mailbox Drafts {
    special_use = \Drafts
  }
  mailbox Sent {
    special_use = \Sent
  }
  mailbox "Sent Messages" {
    special_use = \Sent
  }
  mailbox Archive {
    special_use = \Archive
  }
  mailbox Spam {
    special_use = \Junk
    # Created on first spam by the delivery sieve's `fileinto :create`,
    # but declared here so it exists and is subscribed from the start.
    auto = subscribe
  }
  # Training folder, deliberately separate from Spam. Moving a message
  # *into* it trains that message as spam; moving one *out* trains it
  # as ham. Keeping it apart from Spam means the automatic filing of
  # spam is not itself taken as a training signal.
  mailbox TrainSpam {
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
  }
}

# Sieve
plugin {
  # sieve_imapsieve as well as sieve_extprograms: the learn-ham and
  # learn-spam scripts open with `require ["imapsieve"]`, and that
  # capability only exists once this plugin is loaded. Without it
  # `sievec` refuses to compile them - "unknown Sieve capability
  # `imapsieve'" - and the role fails in its compile handler.
  # Runs before any per-user script, on every delivery, which is how
  # spam gets filed without each account needing its own sieve.
  sieve_before = /etc/dovecot/sieve/spam-to-folder.sieve
{% if imap.managesieve.enabled %}
  # The user's own script storage, which is what ManageSieve reads and
  # writes. Stated rather than left to the default because it is the
  # one location here a user can write to, and because it is what the
  # line above is *before*: the scripts this role deploys live in
  # /etc/dovecot/sieve and are reachable from no client, so spam
  # filing and the training rules survive whatever a user saves.
  sieve = file:~/sieve;active=~/.dovecot.sieve
  sieve_quota_max_scripts = {{ imap.managesieve.max_scripts }}
  sieve_max_script_size = {{ imap.managesieve.max_script_size }}
{% endif %}
  sieve_plugins = sieve_imapsieve sieve_extprograms
  sieve_extensions = +vnd.dovecot.pipe
  sieve_pipe_bin_dir = /etc/dovecot/sieve-pipe
}

plugin {
  imapsieve_mailbox1_name = TrainSpam
  imapsieve_mailbox1_causes = COPY
  imapsieve_mailbox1_before = file:/etc/dovecot/sieve/learn-spam.sieve
  
  imapsieve_mailbox2_name = *
  imapsieve_mailbox2_from = TrainSpam
  imapsieve_mailbox2_causes = COPY
  imapsieve_mailbox2_before = file:/etc/dovecot/sieve/learn-ham.sieve
}
