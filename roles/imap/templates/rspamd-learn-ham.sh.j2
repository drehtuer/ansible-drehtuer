#!/usr/bin/env bash
{{ ansible_managed | comment }}
#
# Piped a message by the imapsieve rules in dovecot.conf when the user
# moves mail *out of* the training folder - the undo of
# rspamd-learn-spam.sh, so it has to undo both halves of it:
#
#   /learnham    reclassifies the message for Bayes, as before.
#   /fuzzydel    withdraws the body hash this host learned from it.
#                Without this a mistaken filing is permanent: Bayes
#                would be corrected while the fuzzy storage went on
#                matching every future message that looks like it.
#
# The Password header is required: RSpamd's controller no longer
# trusts requests merely for arriving from 127.0.0.1, so without it
# every training request is refused - silently, because sieve pipes
# discard the response.
set -euo pipefail

# Both requests need the whole message and stdin can only be read once,
# so it is buffered. mktemp creates it 0600, which matters: this is the
# user's mail sitting in a world-readable directory otherwise.
message="$(mktemp)"
trap 'rm -f "${message}"' EXIT
cat >"${message}"

learn() {
  curl -s --fail \
    -H "Password: {{ spam.controller_password }}" \
    -X POST --data-binary "@${message}" \
    "http://127.0.0.1:{{ spam.http_port }}/${1}"
}

# See the note in rspamd-learn-spam.sh: both are attempted whatever the
# other does, and either failing fails the script.
status=0
learn "learnham" || status=1
learn "fuzzydel?flag={{ spam.fuzzy_flag }}" || status=1
exit "${status}"
