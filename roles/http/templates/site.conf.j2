{{ ansible_managed | comment }}
{#
  One template for every static vhost. `server_name` is the cross
  product of http.domains and the site's subdomains, so adding a
  domain to the inventory extends every vhost automatically.
#}
{% set names = [] %}
{% for d in http.domains %}
{% for s in site.subdomains %}
{% set _ = names.append(d if s == '' else s ~ '.' ~ d) %}
{% endfor %}
{% endfor %}
server {
    listen {{ http.port_https }} ssl http2;
    listen [::]:{{ http.port_https }} ssl http2;
    server_name {{ names | join(' ') }};
    root {{ site.root }};
    index index.html index.php;

    include conf-server/ssl.conf;
    include conf-server/security.conf;
    include conf-server/general.conf;
{% if site.include_locations | default(false) %}
    # Locations contributed by other roles. A glob that matches
    # nothing is fine, so this does not couple the http role to
    # whichever of them have run.
    include locations-enabled/*.conf;
{% endif %}

    # A missing file is a 404, and that is not only tidiness. With the
    # old `/index.html` fallback every unknown path answered 200 with
    # the site's placeholder - so a scanner asking for
    # `/wp-config.php.bak` or `/actuator/env` was told it exists, and
    # `roles/fail2ban`'s `nginx-404` jail could never fire on this
    # vhost because this vhost never produced a 404. Measured on
    # `carcosa`: 59113 probes across 8593 sensitive paths in a
    # fortnight, and not one of them counted towards a ban.
    #
    # `spa_fallback` restores the old behaviour for a site that needs
    # it - a single-page app routing in the browser is the case that
    # genuinely does.
    location / {
        try_files $uri $uri/ {{ '/index.html' if site.spa_fallback | default(false) else '=404' }};
    }

    # handle .php
    location ~ \.php$ {
        fastcgi_pass php_default;
        include      conf-server/php-fpm.conf;
    }
}
