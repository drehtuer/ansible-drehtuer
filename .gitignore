# Ansible
/log/
/vault/
/roles/sshd/keys/
# Plaintext DNSSEC keys. Only the vault-encrypted copies in
# roles/nsd/files/dnssec/ belong in git.
/roles/nsd/keys/
# Console/rescue credentials for the testlab hosts, kept out of the
# repo for the same reason as /vault/. Only the password *hashes*
# belong in git (vaulted, in inventories/group_vars/testlab/users.yml
# and the cloud-init seed in .claude/skills/testlab/vm.sh).
#
# `/kvm/*` rather than `/kvm/`: git does not descend into an excluded
# *directory*, so the negation below would never be considered and
# .gitkeep could not be committed. Excluding the contents instead
# leaves the directory itself visible.
/kvm/*
!/kvm/.gitkeep
# Throwaway host key pair generated by roles/sshd/molecule/default/,
# cleaned up by its cleanup.yml - ignored too in case a run is
# interrupted before cleanup runs.
/roles/sshd/files/ssh_moleculetest_*
/molecule-verify.log

# Python bytecode from `import tasks`
__pycache__/

# Ruff
/.ruff_cache/

# Rendered documentation, built by `invoke docs` and published by
# .github/workflows/docs.yml. Generated on every build, so committing
# it would only ever produce diffs nobody reads.
/public/
# The Antora component, assembled from doc/ by `invoke docs`. Antora
# needs its own layout; this is where that layout is built rather than
# imposed on the sources.
/build/
